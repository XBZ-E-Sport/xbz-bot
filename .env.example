# === Variables d'environnement du bot XBZ (à définir sur Render) ===

# Token du bot Discord — SECRET, ne jamais commiter ni partager.
TOKEN=xxxxxxxx

# --- Connexion Supabase (synchro des candidatures) ---
# URL du projet Supabase (même projet que le site).
SUPABASE_URL=https://xxxx.supabase.co
# Clé service_role — SECRET (permet d'écrire dans candidatures.statut).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Sécurité de l'API entrante ---
# Doit être IDENTIQUE au BOT_SHARED_SECRET du site xbz-web.
# Le site l'envoie dans l'en-tête x-xbz-secret ; le bot rejette sinon.
BOT_SHARED_SECRET=change-me

# --- Panel de supervision (/panel) ---
# Mot de passe du bouton « Redémarrer ». Vide → redémarrage désactivé.
PANEL_PASSWORD=

# --- Salons Discord (optionnel) ---
# Salon où poster les messages du formulaire de support.
# À défaut → salon staff. (Les autres IDs de salons sont dans bot.js.)
SUPPORT_CHANNEL_ID=

# PORT et RENDER_EXTERNAL_URL sont fournis automatiquement par Render.
